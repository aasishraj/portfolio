---
import VisitorCounter from './VisitorCounter.astro';
---

<footer class="border-t border-(--border) bg-(--card-muted) py-12 px-6 mt-16">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8">
      <h3 class="text-xl font-bold mb-2">Let's Connect</h3>
      <p class="text-sm text-(--muted-foreground) mb-5">
        Feel free to reach out for collaborations or just a friendly hello!
      </p>
      
      <div class="flex justify-center gap-3 mb-6">
        <a href="mailto:mail@aasishraj.com" class="btn-control text-xs">
          <svg class="h-3.5 w-3.5 text-(--weights)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Email
        </a>
      </div>

      <div class="mt-4 flex justify-center">
        <VisitorCounter />
      </div>
    </div>
    
    <div class="border-t border-(--border) pt-6 text-center text-xs text-(--muted-foreground) space-y-1">
      <p>&copy; {new Date().getFullYear()} Aasish Raj. All rights reserved.</p>
      <p>Built with Astro & TypeScript. Styled with aesthetic simplicity.</p>
    </div>
  </div>
</footer>
