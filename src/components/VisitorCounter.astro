---

<div id="visitor-counter-container" class="flex items-center justify-center gap-2 text-xs text-(--muted-foreground) min-h-6">
  <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span id="visitor-counter-text">Loading visitors...</span>
</div>

<script is:inline>
  (function () {
    const textEl = document.getElementById('visitor-counter-text');
    if (!textEl) return;

    fetch('/api/visitor-count', { cache: 'no-store' })
      .then((res) => res.json())
      .then((data) => {
        if (typeof data.count === 'number') {
          const countStr = data.count.toLocaleString();
          const word = data.count === 1 ? 'visitor' : 'visitors';
          const welcome = data.isNewVisitor ? ' <span style="color: var(--runtime); font-weight: 500;">(Welcome! 👋)</span>' : '';
          textEl.innerHTML = `<strong>${countStr}</strong> ${word}${welcome}`;
        } else {
          textEl.textContent = 'Visitors';
        }
      })
      .catch(() => {
        textEl.textContent = 'Visitors';
      });
  })();
</script>
