---
import Icon from './Icon.astro';

interface Technology {
  name: string;
  description?: string;
  url?: string;
}

interface GithubLink {
  name: string;
  url: string;
}

interface Project {
  title: string;
  description: string;
  technologies: Technology[];
  organization?: string;
  organizationFullName?: string;
  organizationUrl?: string;
  githubUrl?: string;
  githubUrls?: GithubLink[];
  liveUrl?: string;
}

const freelanceProjects: Project[] = [
  {
    title: "Energentic",
    description: "Built a Beckn protocol-based energy assistant for consumer grid queries and notifications",
    technologies: [
      { name: "Beckn Protocol", url: "https://becknprotocol.io/" },
      { name: "Langchain", url: "https://www.langchain.com/" },
      { name: "Websocket" },
    ],
    organization: "FIDE",
    organizationFullName: "Foundation for Interoperability in Digital Economy",
    organizationUrl: "https://fide.org/",
  },
  {
    title: "Reconciliation Engine",
    description: "Production ready financial reconciliation system",
    technologies: [
      { name: "FastAPI", url: "https://fastapi.tiangolo.com/" },
      { name: "AWS", url: "https://aws.amazon.com/" },
      { name: "Docker Swarm", url: "https://docs.docker.com/engine/swarm/" },
    ],
    organization: "Open Fintech",
    organizationFullName: "Open Financial Technologies",
    organizationUrl: "https://open.money/",
  },
  {
    title: "Banaras Tourism Data Analysis",
    description: "Extracted insights from google maps reviews and instagram posts",
    technologies: [
      { name: "BERT" },
      { name: "LDA" },
      { name: "NLP" },
    ],
    organization: "BHU",
    organizationFullName: "Banaras Hindu University",
    organizationUrl: "https://www.bhu.ac.in/",
  },
];

const personalProjects: Project[] = [
  {
    title: "ezlab - Educational Portal API",
    description: "Rebuilt ETLAB interface with secure auth and documentation",
    technologies: [
      { name: "API" },
      { name: "Authentication" },
      { name: "Education" },
      { name: "Documentation" },
    ],
    liveUrl: "https://ezlab.vercel.app",
  },
  {
    title: "Teehee.chat",
    description: "An open-source variant of t3.chat by Theo.",
    technologies: [
      { name: "Open Source" },
      { name: "FastAPI" },
      { name: "TypeScript" },
      { name: "Python" },
    ],
    githubUrls: [
      { name: "Frontend", url: "https://github.com/aasishraj/teehee-chat-frontend" },
      { name: "Backend", url: "https://github.com/aasishraj/teehee-chat-backend" },
    ],
    liveUrl: "https://v0-teehee-chat.vercel.app/",
  },
  {
    title: "Todo App",
    description: "A minimal todo application with in-browser memory.",
    technologies: [{ name: "Web Storage" }, { name: "TypeScript" }],
    liveUrl: "https://todo.aasishraj.com",
  },
  {
    title: "Flashcard App",
    description: "A minimal flashcard application with in-browser memory.",
    technologies: [{ name: "Web Storage" }, { name: "TypeScript" }],
    liveUrl: "https://flash.aasishraj.com",
  },
  {
    title: "Python Playground",
    description: "An in-memory python playground running via WebAssembly.",
    technologies: [
      { name: "Python" },
      { name: "WebAssembly" },
      { name: "Pyodide" },
    ],
    liveUrl: "https://python.aasishraj.com",
  },
];
---

<section id="projects" class="py-12 px-6 scroll-mt-14">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h2 class="text-2xl font-bold tracking-tight mb-2">Projects</h2>
    </div>

    <!-- Freelance -->
    <div class="mb-10">
      <h3 class="text-lg font-semibold mb-4 text-(--weights)">Freelance & Client Work</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {freelanceProjects.map((project) => (
          <div class="card-surface p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h4 class="font-semibold text-base">{project.title}</h4>
                {project.organization && (
                  <a
                    href={project.organizationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={project.organizationFullName}
                    class="chip text-xs hover:border-(--weights) transition-colors"
                  >
                    {project.organization}
                  </a>
                )}
              </div>
              <p class="text-sm text-(--muted-foreground) mb-4">{project.description}</p>
              
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.technologies.map((tech) => (
                  <span class="chip text-xs">{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-(--border)">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-control text-xs"
                >
                  <Icon name="ui/external-link" class="h-3.5 w-3.5" />
                  Live Demo
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Personal -->
    <div>
      <h3 class="text-lg font-semibold mb-4 text-(--cache)">Personal & Open Experiments</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {personalProjects.map((project) => (
          <div class="card-surface p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h4 class="font-semibold text-base">{project.title}</h4>
              </div>
              <p class="text-sm text-(--muted-foreground) mb-4">{project.description}</p>
              
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.technologies.map((tech) => (
                  <span class="chip text-xs">{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-(--border)">
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-control text-xs"
                >
                  <Icon name="ui/github-outline" class="h-3.5 w-3.5" />
                  Code
                </a>
              )}
              {project.githubUrls && project.githubUrls.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-control text-xs"
                >
                  <Icon name="ui/github-outline" class="h-3.5 w-3.5" />
                  {link.name}
                </a>
              ))}
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-control text-xs"
                >
                  <Icon name="ui/external-link" class="h-3.5 w-3.5" />
                  Live Demo
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
