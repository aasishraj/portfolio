---
import Icon from './Icon.astro';
---

<section class="pt-16 pb-12 px-6 text-center">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <div class="inline-block relative mb-5">
        <img
          src="/blpfp.jpg"
          alt="Aasish Raj"
          width="120"
          height="120"
          class="h-28 w-28 md:h-32 md:w-32 rounded-full object-cover mx-auto border-2 border-(--border) shadow-sm"
          loading="eager"
        />
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3">Aasish Raj</h1>
      <p class="text-sm md:text-base text-(--muted-foreground) max-w-lg mx-auto mb-5">
        Software developer working across systems, machine learning, and generative AI.
      </p>
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        <span class="chip chip-blue">Gen AI</span>
        <span class="chip chip-amber">System Design</span>
        <span class="chip chip-teal">AI/ML</span>
      </div>
    </div>
    
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="https://github.com/aasishraj"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="btn-control"
      >
        <Icon name="socials/github" class="h-4 w-4" />
      </a>
      <a
        href="https://x.com/aasishrajrr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Twitter"
        class="btn-control"
      >
        <Icon name="socials/twitter" class="h-4 w-4" />
      </a>
      <a
        href="https://codolio.com/profile/aasish"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Codolio"
        class="btn-control"
      >
        <Icon name="socials/codolio" class="h-4 w-4 grayscale" />
      </a>
    </div>
  </div>
</section>
